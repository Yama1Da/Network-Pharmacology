# 示例密钥文件

# 请将"your_api_key"替换为您自己的API密钥,并把文件保存为API.env
DisGeNET_API_KEY="your_api_key"

# 分子对接:AutoDock Vina 所在目录(跨平台,也可填可执行文件全路径;不设则从 PATH 探测)
# VINA_DIR="your_vina_dir"
# 分子对接受体转换:Open Babel(obabel)所在目录(跨平台,也可填可执行文件全路径;不设则从 PATH 探测)

# OBABEL_DIR="your_obabel_dir"
# CLI 结果输出目录(可选):配置后 python cli.py 各命令的结果默认落在此目录;不设则用当前目录下的 results
# CLI_RESULTS_DIR="your_cli_results_dir"

# NCBI E-utilities API key(可选):注册免费 https://www.ncbi.nlm.nih.gov/account/
# 无 key 按 3 次/秒限速可用;配置后 10 次/秒,仅 GEO 数据集检索使用
NCBI_API_KEY ="your_geo_key"
