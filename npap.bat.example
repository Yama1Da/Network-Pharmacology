@echo off
rem Transitional entry point for the npap CLI (see README "Command-Line Batch Analysis").
rem
rem One-time setup: copy this file as "npap.bat" (keep it next to WY\) and put the folder
rem containing npap.bat on PATH. The copied npap.bat holds machine-specific paths, so it is
rem gitignored (same policy as API.env); only this template is committed.
rem
rem Default below resolves paths relative to this file's own location (%~dp0), so it works
rem unmodified for the standard layout (project venv at the repository root as .venv).
rem If you use a conda env or keep the bat elsewhere, replace both paths with absolute ones.
rem
rem Python is pinned instead of plain "python" so the command works even when the system
rem Python (first in PATH) lacks the project dependencies.
"%~dp0.venv\Scripts\python.exe" "%~dp0WY\cli.py" %*
